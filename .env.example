# Per-machine stack config. Copy to .env (gitignored) on EACH machine:
#
#   cp .env.example .env
#   ${EDITOR:-vim} .env
#
# This is the only file that names compose files. Every script under bin/
# reads COMPOSE_FILE from here via docker compose's own env handling, so
# moving the agent half to a different machine — say a Linux box instead of
# a Mac — is a rename plus one line here, and no script changes:
#
#   git mv docker-compose.mac.yml docker-compose.linux.yml
#   # then update COMPOSE_FILE below
#
# COMPOSE_FILE is a native docker compose variable: with it set, plain
# `docker compose up -d` / `ps` / `logs` work in this directory with no -f
# flags at all.

# ---------------------------------------------------------------------------
# Which half of the hybrid stack THIS machine runs.
#   workstation — manager-agent + the employee agents (the heavy half)
#   vps         — n8n only, behind the host's nginx (the public half)
# ---------------------------------------------------------------------------
STACK_ROLE=workstation

# ---------------------------------------------------------------------------
# Compose files, colon-separated, in override order.
#
#   workstation:  docker-compose.mac.yml:docker-compose.employees.yml
#                 (the second one is GENERATED by
#                  ./bin/render-employees-compose.sh — bin/up.sh renders it
#                  for you before bringing anything up)
#
#   vps:          docker-compose.vps.yml
# ---------------------------------------------------------------------------
COMPOSE_FILE=docker-compose.mac.yml:docker-compose.employees.yml
COMPOSE_PATH_SEPARATOR=:

# ---------------------------------------------------------------------------
# WORKSTATION ONLY — the host IP that manager-agent's sshd is published on.
# Set it to this machine's Tailscale address (100.x.y.z) so only tailnet
# peers can reach it; it must match `host` in
# n8n/secrets/ssh-manager-agent.json on the VPS.
#
#   tailscale ip -4
#
# The 127.0.0.1 default fails closed: the VPS cannot connect, which is safer
# than accidentally publishing sshd to the local network.
# ---------------------------------------------------------------------------
MANAGER_SSH_BIND=127.0.0.1
