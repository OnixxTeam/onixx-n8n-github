# Config for bin/gh-webhooks-sync.sh.
#
# Copy to gh-webhooks.env (same dir, gitignored via *.env) and fill in:
#   cp gh-webhooks.env.example gh-webhooks.env
#   chmod 600 gh-webhooks.env
#
# Both values can also be passed as positional args to the script; args
# take precedence over this file.

# GitHub organization. The script installs a single org-level webhook
# that fires for every repo in the org — agents can then be summoned
# from any repo without per-repo wiring. Use the per-repo fallback
# (./bin/gh-webhooks-sync.sh repo <owner/repo> <base-url>) only if you
# need to attach to one specific repo outside an org context.
GH_ORG=onymchat

# Public base URL where n8n's /webhook/<path> endpoints are reachable.
# This is the same domain Caddy terminates TLS at — should equal
# N8N_PUBLIC_HOST in caddy.env (and the host portion of WEBHOOK_URL in
# n8n.env), prefixed with https://. No trailing slash.
WEBHOOK_BASE_URL=https://n8n.example.com
