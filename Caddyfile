# onym-n8n public ingress.
#
# Caddy terminates TLS at the host's 443 (and serves the ACME HTTP-01
# challenge on 80), then reverse-proxies to n8n at n8n:5678 over the
# orchestration docker network. n8n itself never publishes a public port.
#
# {$N8N_PUBLIC_HOST} and {$ACME_EMAIL} are substituted at startup from
# caddy.env. Both must be set; ACME_EMAIL can be empty (Caddy falls back
# to anonymous Let's Encrypt registration).
#
# Reload after editing this file:
#   docker compose -f docker-compose.dev.yml exec caddy caddy reload --config /etc/caddy/Caddyfile

{
	email {$ACME_EMAIL}
}

{$N8N_PUBLIC_HOST} {
	encode zstd gzip

	# n8n trusts X-Forwarded-Proto when N8N_PROXY_HOPS=1; Caddy sets
	# the X-Forwarded-* family automatically.
	reverse_proxy n8n:5678 {
		# Long-running webhooks (workflow executions) can take a while.
		transport http {
			read_timeout  10m
			write_timeout 10m
		}
	}

	# Tighten the default header set: n8n already sets its own CSP for
	# the editor; we just add HSTS so browsers pin HTTPS for a year.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Don't leak the upstream's Server header.
		-Server
	}
}
