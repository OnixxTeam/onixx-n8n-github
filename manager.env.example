# Manager-agent env. Copy to manager.env and fill in.
#
#   cp manager.env.example manager.env
#   chmod 600 manager.env
#
# The manager has two responsibilities:
#   1. Receive every n8n SSH dispatch and route it to the right employee
#      (see bin/n8n-manager-dispatch.sh).
#   2. Post a visible "routed to @<employee>" comment on the source
#      surface as its own GitHub identity (configured in employees.json
#      → manager.githubLogin).
#
# That means the manager bot's PAT needs scopes for every surface the
# routing comment is posted on:
#   - issues:RW, pull_requests:RW (issue + PR comments)
#   - read:discussion + write:discussion (discussion comments via
#     GraphQL addDiscussionComment)
#   - contents:R + metadata:R (read repo on demand)
#   - read:org (the workflows still gate inbound by org membership and
#     this token is reused for the org-membership lookup if the
#     dispatcher does it inline)
GITHUB_TOKEN=ghs_REPLACE_ME

# Claude Code — used by the dispatcher when it has to ask claude to
# pick the best employee (the routing-by-specialization fallback path).
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Per-bot git identity (cosmetic on commits — the manager itself
# rarely commits, but the value flows into the employee env files at
# render time).
GIT_COMMITTER_NAME=onym-manager
GIT_COMMITTER_EMAIL=onym-manager@bots.onym-n8n.local

# n8n's pubkey for inbound SSH from the orchestration stack. Must match
# the private half embedded in n8n/secrets/manager-ssh.json. Generate
# once with:
#   ssh-keygen -t ed25519 -f n8n/secrets/n8n-manager-key -N ""
# Paste the full single-line ssh-ed25519 string from the .pub file here.
N8N_SSH_PUBKEY=

# Optional: admin / operator SSH pubkey for direct interactive access
# to the manager container (debugging the dispatcher, tailing logs).
# This key bypasses the manager dispatcher entirely — it lands you at a
# shell as the `agent` user.
ADMIN_SSH_PUBKEY=

# Mac host delegation (only needed if any employee runs iOS / Android
# NDK builds via the host-build-dispatch path).
MAC_HOST=host.docker.internal
MAC_HOST_USER=your-mac-account
MAC_HOST_PORT=22
