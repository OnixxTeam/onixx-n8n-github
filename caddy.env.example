# Caddy env — copy to caddy.env. Values are read at container start and
# substituted into Caddyfile via {$VAR_NAME}.
#
#   cp caddy.env.example caddy.env
#   chmod 600 caddy.env
#   ${EDITOR:-vim} caddy.env

# Public hostname for the n8n ingress. Must have a DNS A/AAAA record
# pointing at the host's public IP — Let's Encrypt's ACME HTTP-01
# challenge fetches http://<host>/.well-known/acme-challenge/... over
# port 80 to issue the cert.
#
# Must match N8N_HOST in n8n.env (and the host portion of WEBHOOK_URL).
N8N_PUBLIC_HOST=n8n.example.com

# Contact email for Let's Encrypt registration. They'll email cert-expiry
# warnings here if renewal ever stalls. Leave empty for anonymous
# registration (Caddy still issues + renews; no expiry warnings).
ACME_EMAIL=admin@example.com
