        "options": { "response": { "response": { "fullResponse": true, "neverError": true } } }
      },
      "id": "a6000000-0000-0000-0000-000000000003",
      "name": "Org membership",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [600, 300],
      "credentials": { "githubApi": { "id": "REPLACE_ME", "name": "manager GitHub" } }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "b6000000-0000-0000-0000-000000000020",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 204,
              "operator": { "type": "number", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a6000000-0000-0000-0000-000000000004",
      "name": "Is org member?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [740, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $('Webhook').item.json.body.repository.full_name }}/pulls/{{ $('Webhook').item.json.body.issue.number }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Accept", "value": "application/vnd.github+json" },
            { "name": "X-GitHub-Api-Version", "value": "2022-11-28" }
          ]
        },
        "options": {}
      },
      "id": "a6000000-0000-0000-0000-000000000005",
      "name": "Get PR",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 300],
      "credentials": { "githubApi": { "id": "REPLACE_ME", "name": "manager GitHub" } }
    },
    {
      "parameters": {
        "jsCode": "const b = $('Webhook').item.json.body;\nconst pr = $json;\nconst text = (b.comment.body || '').trim();\nconst m = text.match(/^\\/merge\\s+(squash|rebase|merge)\\b/i);\nconst mergeMethod = m ? m[1].toLowerCase() : 'squash';\nconst senderLogin = b.sender && b.sender.login;\nconst allowed = (($env.MERGE_AUTHORIZED_LOGINS || 'alexpovstin,gramyzer').split(',').map(s => s.trim()).filter(Boolean));\nif (!allowed.includes(senderLogin)) {\n  return [];\n}\nconst args = {\n  surface: 'pr-merge',\n  repoOwner: b.repository.owner.login,\n  repoName: b.repository.name,\n  repoFull: b.repository.full_name,\n  senderLogin,\n  senderType: b.sender && b.sender.type,\n  prNumber: b.issue.number,\n  prTitle: pr.title,\n  mergeMethod,\n  promptB64: '',\n};\nreturn [{ json: { argsB64: Buffer.from(JSON.stringify(args), 'utf8').toString('base64') } }];\n"
      },
      "id": "a6000000-0000-0000-0000-000000000006",
      "name": "Build args",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1080, 300]
    },
    {
      "parameters": {
        "authentication": "privateKey",
        "resource": "command",
        "command": "=exec n8n-manager-dispatch \"{{ $json.argsB64 }}\"\n"
      },
      "id": "a6000000-0000-0000-0000-000000000007",
      "name": "Dispatch via manager",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [1280, 300],
      "credentials": { "sshPrivateKey": { "id": "REPLACE_ME", "name": "manager-agent SSH" } }
    }
  ],
