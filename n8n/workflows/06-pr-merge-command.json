      "id": "a6000000-0000-0000-0000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 300],
      "webhookId": "pr-merge"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "b6000000-0000-0000-0000-000000000001",
              "leftValue": "={{ (() => { const b = $json.body; if (b.action !== 'created') return false; if (!b.issue || !b.issue.pull_request) return false; if (b.sender && b.sender.type === 'Bot') return false; const text = ((b.comment && b.comment.body) || '').trim(); return /^\\/merge\\b/i.test(text); })() }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
